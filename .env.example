# ── Required ──────────────────────────────────────────────────────
GEMINI_API_KEY=
JWT_SECRET=

# ── App mode (optional) ──────────────────────────────────────────
# 'self' (default when unset) - single-user / self-host. All gates
# off, all features free, no billing. Best for personal instances.
# 'hosted' - multi-tenant with Stripe gating + email-PIN auth +
# subscription tiers. Requires RESEND_API_KEY (transactional emails)
# and STRIPE_* keys.
# APP_MODE=self

# ── Auth (optional) ──────────────────────────────────────────────
# Google OAuth client ID for Google sign-in
# GOOGLE_CLIENT_ID=

# ── Admin (optional) ─────────────────────────────────────────────
# Comma-separated list of admin emails (case-insensitive). These
# accounts can hit /admin/* endpoints and see the Admin Metrics
# page. Empty/unset disables admin access entirely.
# ADMIN_EMAIL=you@example.com

# ── Database (optional) ─────────────────────────────────────────
# SQLite database path (default: macro_app.db)
# DB_PATH=macro_app.db

# ── Hosting / Reverse Proxy (optional) ──────────────────────────
# DOMAIN=example.com
# BASE_PATH=/macro_app
# BASE_URL=https://example.com/macro_app
# APP_URL=https://example.com/macro_app/
# OG_IMAGE_URL=https://example.com/macro_app/og-image.png

# ── Operator identity (shown publicly in UI, emails, legal pages) ──
# Who runs this instance. Used by email signatures ("Cheers, {first_name}"),
# the legal data-controller text in Terms/Privacy, and the contact email
# everywhere support/refund requests route to. Leaving these blank is
# fine for local dev - the UI falls back to generic copy.
# OPERATOR_NAME=Your Name
# OPERATOR_FIRST_NAME=Your
# CONTACT_EMAIL=you@example.com
# GITHUB_URL=https://github.com/your-org/macro_app

# Frontend build-time copies of the public-facing values above. Vite
# only exposes VITE_*-prefixed vars to the browser, so these feed
# index.html's og:url / og:image meta tags at build time AND the first
# paint of Privacy / Terms / About (before /api/config loads). Set them
# to match APP_URL / OG_IMAGE_URL / OPERATOR_NAME / CONTACT_EMAIL /
# GITHUB_URL for the deployed instance.
# VITE_APP_URL=https://example.com/macro_app/
# VITE_OG_IMAGE_URL=https://example.com/macro_app/og-image.png
# VITE_OPERATOR_NAME=Your Name
# VITE_CONTACT_EMAIL=you@example.com
# VITE_GITHUB_URL=https://github.com/your-org/macro_app

# ── Stripe Billing (optional - omit for free self-hosted mode) ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=price_xxx

# ── Strava Integration (optional) ───────────────────────────────
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_VERIFY_TOKEN=

# ── Fitbit Integration (optional) ───────────────────────────────
# FITBIT_CLIENT_ID=
# FITBIT_CLIENT_SECRET=
# FITBIT_VERIFY_CODE=

# ── Oura Ring Integration (optional) ────────────────────────────
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=
# OURA_VERIFY_TOKEN=

# ── Push Notifications (optional) ───────────────────────────────
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_CLAIM_EMAIL=mailto:you@example.com

# ── Email PIN Login (optional in self-host mode, REQUIRED in hosted mode) ──
# Resend.com API key for sending login PIN emails + transactional
# (subscription receipts, trial reminders, etc.). Required when
# APP_MODE=hosted; the app uses the presence of this key as a
# secondary "is this production?" indicator. Safe to leave unset for
# personal/self-host use - the dev fallback below prints PINs to the
# server log so you can sign in without configuring email.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=login@example.com

# Local-dev fallback: when RESEND_API_KEY is unset, print the login
# PIN to the uvicorn stderr/log instead of trying to email it. Lets
# anyone trying the app via the README Quick Start sign in without
# first signing up for Resend. UNSET THIS IN PRODUCTION.
DEBUG_SHOW_PINS=1

# ── FatSecret (optional - improves macro accuracy) ──────────────
# FATSECRET_KEY=
# FATSECRET_SECRET=
