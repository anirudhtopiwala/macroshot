# OS
.DS_Store
Thumbs.db

# SQLite database + WAL-mode sidecars (runtime artifacts). The -wal / -shm
# files MUST be gitignored - long-running uvicorn processes hold open file
# descriptors to them, and any tool that runs `git clean -fd` on the worktree
# will silently unlink them from under the service, leaving it reading a
# deleted (and soon-to-be-checkpointed-back) WAL.
*.db
*.db-wal
*.db-shm
*.db-journal

# Test coverage artifacts
.coverage
htmlcov/

# Node / Frontend
node_modules/
web/dist/
web/.vite/

# Uploaded images (runtime data)
data/images/

# DB backups (runtime)
backups/
logs/

# Meal-analysis eval: real meals + images + run outputs are private to the
# operator. The Nutrition5k benchmark is explicitly tracked; it has its
# own nested .gitignore for large image bytes and run outputs.
eval/*
!eval/nutrition5k/
!eval/nutrition5k/**

# Offline validation review - pulled via scripts/pull_validation_dataset.py.
# Private per-user meal images + text; never commit.
validation_dataset/
